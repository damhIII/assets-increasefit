{
  "name": "increasefit-reel",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "instalar": "npm install --no-audit --no-fund --loglevel=error",
    "studio": "remotion studio",
    "tipos": "tsc --noEmit --pretty false",
    "revisar": "node scripts/stills.mjs --revisar",
